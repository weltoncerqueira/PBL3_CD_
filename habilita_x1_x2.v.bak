//Verifica se delta é negativo. Caso seja, o valor de x1 e x2 é zerado
//Tambem verifica se a = zero. Caso seja, o valor de x1 e x2 é zerado
module habilita_x1_x2 (
	input  [8:0] x1, x2, 
	input  sinal_delta, flag_a_zero,
	output [8:0] x1_saida, x2_saida
);
	
	////Habilita a passagem de x1 e x2 com base na flag (sinal_delta)
	mux_2x1 mux_01 (.A(x1[0]), .B(1'b0), .S(sinal_delta), .Y(x1_saida[0]));
	mux_2x1 mux_02 (.A(x1[1]), .B(1'b0), .S(sinal_delta), .Y(x1_saida[1]));
	mux_2x1 mux_03 (.A(x1[2]), .B(1'b0), .S(sinal_delta), .Y(x1_saida[2]));
	mux_2x1 mux_04 (.A(x1[3]), .B(1'b0), .S(sinal_delta), .Y(x1_saida[3]));
	mux_2x1 mux_05 (.A(x1[4]), .B(1'b0), .S(sinal_delta), .Y(x1_saida[4]));
	mux_2x1 mux_06 (.A(x1[5]), .B(1'b0), .S(sinal_delta), .Y(x1_saida[5]));
	mux_2x1 mux_07 (.A(x1[6]), .B(1'b0), .S(sinal_delta), .Y(x1_saida[6]));
	mux_2x1 mux_08 (.A(x1[7]), .B(1'b0), .S(sinal_delta), .Y(x1_saida[7]));
	mux_2x1 mux_09 (.A(x1[8]), .B(1'b0), .S(sinal_delta), .Y(x1_saida[8]));
	
	mux_2x1 mux_11 (.A(x2[0]), .B(1'b0), .S(sinal_delta), .Y(x2_saida[0]));
	mux_2x1 mux_12 (.A(x2[1]), .B(1'b0), .S(sinal_delta), .Y(x2_saida[1]));
	mux_2x1 mux_13 (.A(x2[2]), .B(1'b0), .S(sinal_delta), .Y(x2_saida[2]));
	mux_2x1 mux_14 (.A(x2[3]), .B(1'b0), .S(sinal_delta), .Y(x2_saida[3]));
	mux_2x1 mux_15 (.A(x2[4]), .B(1'b0), .S(sinal_delta), .Y(x2_saida[4]));
	mux_2x1 mux_16 (.A(x2[5]), .B(1'b0), .S(sinal_delta), .Y(x2_saida[5]));
	mux_2x1 mux_17 (.A(x2[6]), .B(1'b0), .S(sinal_delta), .Y(x2_saida[6]));
	mux_2x1 mux_18 (.A(x2[7]), .B(1'b0), .S(sinal_delta), .Y(x2_saida[7]));
	mux_2x1 mux_19 (.A(x2[8]), .B(1'b0), .S(sinal_delta), .Y(x2_saida[8]));
	
	//Habilita a passagem de x1 e x2 com base na flag (a_zero)
	mux_2x1 mux_001 (.A(x1[0]), .B(1'b0), .S(flag_a_zero), .Y(x1_saida[0]));
	mux_2x1 mux_002 (.A(x1[1]), .B(1'b0), .S(flag_a_zero), .Y(x1_saida[1]));
	mux_2x1 mux_003 (.A(x1[2]), .B(1'b0), .S(flag_a_zero), .Y(x1_saida[2]));
	mux_2x1 mux_004 (.A(x1[3]), .B(1'b0), .S(flag_a_zero), .Y(x1_saida[3]));
	mux_2x1 mux_005 (.A(x1[4]), .B(1'b0), .S(flag_a_zero), .Y(x1_saida[4]));
	mux_2x1 mux_006 (.A(x1[5]), .B(1'b0), .S(flag_a_zero), .Y(x1_saida[5]));
	mux_2x1 mux_007 (.A(x1[6]), .B(1'b0), .S(flag_a_zero), .Y(x1_saida[6]));
	mux_2x1 mux_008 (.A(x1[7]), .B(1'b0), .S(flag_a_zero), .Y(x1_saida[7]));
	mux_2x1 mux_009 (.A(x1[8]), .B(1'b0), .S(flag_a_zero), .Y(x1_saida[8]));
	
	mux_2x1 mux_111 (.A(x2[0]), .B(1'b0), .S(flag_a_zero), .Y(x2_saida[0]));
	mux_2x1 mux_112 (.A(x2[1]), .B(1'b0), .S(flag_a_zero), .Y(x2_saida[1]));
	mux_2x1 mux_113 (.A(x2[2]), .B(1'b0), .S(flag_a_zero), .Y(x2_saida[2]));
	mux_2x1 mux_114 (.A(x2[3]), .B(1'b0), .S(flag_a_zero), .Y(x2_saida[3]));
	mux_2x1 mux_115 (.A(x2[4]), .B(1'b0), .S(flag_a_zero), .Y(x2_saida[4]));
	mux_2x1 mux_116 (.A(x2[5]), .B(1'b0), .S(flag_a_zero), .Y(x2_saida[5]));
	mux_2x1 mux_117 (.A(x2[6]), .B(1'b0), .S(flag_a_zero), .Y(x2_saida[6]));
	mux_2x1 mux_118 (.A(x2[7]), .B(1'b0), .S(flag_a_zero), .Y(x2_saida[7]));
	mux_2x1 mux_119 (.A(x2[8]), .B(1'b0), .S(flag_a_zero), .Y(x2_saida[8]));
		
endmodule